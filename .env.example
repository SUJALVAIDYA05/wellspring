# ==============================================================================
# Environment Variables Template — Hospital Website
# NOTE: Never commit actual credentials or production secrets to source control.
# Copy this file to .env.local for local development.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Required by backend.md for Prisma ORM
DATABASE_URL="postgresql://postgres:password@localhost:5432/wellspring?schema=public"

# Authentication & Session Management
# Secret used to encrypt cookies and session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET="your-development-auth-secret-min-32-chars-long"

# NextAuth / Base Application URL
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Hospital Operational Configuration
# IANA Timezone identifier (do not assume server timezone is the hospital timezone)
HOSPITAL_TIMEZONE="America/New_York"

# Booking Policy
# Duration (in minutes) for which a PENDING booking locks a slot before expiring
PENDING_SLOT_HOLD_MINUTES="15"
